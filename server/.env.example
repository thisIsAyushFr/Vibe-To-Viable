# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/caresync
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=caresync

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Gemini API (Future Phase)
GEMINI_API_KEY=your-gemini-api-key

# Groq API (PLACEHOLDER - CHANGE SOON: set your own key in server/.env, never commit a real key)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=caresync-documents

# Logging
LOG_LEVEL=debug
