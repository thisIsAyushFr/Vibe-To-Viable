{
  "name": "caresync-server",
  "version": "1.0.0",
  "description": "CareSync - AI-powered hospital intelligence platform backend",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:reset": "tsx src/database/reset.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "healthcare",
    "hospital",
    "clinic",
    "appointment",
    "patient",
    "doctor",
    "workload",
    "burnout"
  ],
  "author": "CareSync Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.21.4",
    "axios": "^1.6.0",
    "csv-parse": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/csv-parse": "^1.2.2",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.0.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0"
  }
}
